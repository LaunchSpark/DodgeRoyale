# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local configuration and OS files
.env
.env.*
!.env.example
.DS_Store
*.log

# Third-party reference material (not redistributable)
reference/

# Python trainer: caches, build artifacts, virtual environments, and the
# checkpoints and logs a training run writes beside its code.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
training/.venv/
training/runs/
training/checkpoints/
# Tests launched from the repository root use the same relative checkpoint dir.
/checkpoints/
# A registered git worktree, not repository content.
/.claude/worktrees/
