# Local development credentials used by Docker Compose.
POSTGRES_USER=dodgeroyale
POSTGRES_PASSWORD=dodgeroyale
POSTGRES_DB=dodgeroyale
POSTGRES_PORT=5432

# Native runs connect through localhost. Update this URL if you change the above.
# Compose supplies its own URL using the db service hostname.
DATABASE_URL=postgres://dodgeroyale:dodgeroyale@localhost:5432/dodgeroyale
RUST_LOG=info
