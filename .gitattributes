# Auto detect text files and perform LF normalization
* text=auto
*.sql text eol=lf

# Golden protocol fixtures are compared byte for byte by two languages, so
# nothing may normalise them. The auto heuristic would almost certainly call
# these binary anyway; "almost certainly" is not a guarantee worth relying on.
tests/fixtures/gym-v2/*.bin binary
tests/fixtures/gym-v2/manifest.json text eol=lf
tests/fixtures/player-motion/*.bin binary
tests/fixtures/player-motion/manifest.json text eol=lf
